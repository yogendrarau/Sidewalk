# SIDEWALK v3 — copy to .env and fill what you have. Everything absent falls back per BLOCKERS.md.

# --- Base44 (emulated locally; set when porting to the hosted platform)
BASE44_APP_ID=

# --- NYC Open Data (works without a token at low volume; token raises to 1,000 req/hr)
SOCRATA_APP_TOKEN=

# --- Model gateway
# Anthropic key powers: explainer narration, vision document/menu extraction, Claude-as-NLI entailment check.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Managed Whisper-class ASR (OpenAI-compatible /audio/transcriptions). Empty → browser SpeechRecognition tier.
ASR_ENDPOINT=
ASR_API_KEY=
ASR_MODE=managed

# ElevenLabs-class TTS. Empty → browser speechSynthesis tier.
ELEVENLABS_API_KEY=
TTS_ROUTING=default

# DeBERTa-class NLI endpoint (POST {premise, hypothesis} → {label}). Empty → deterministic gate (+Claude-NLI if key above).
NLI_ENDPOINT=

# Extraction chain: vlm (Anthropic vision) → fixture (sha-matched demo fixtures) → manual
EXTRACT_MODE=vlm

# --- Shopify dev store (source of truth for products/checkout/orders; invariant 14).
# Empty → simulated catalog + hosted-checkout stand-in that fires the same HMAC-signed webhook locally.
#
# PREFERRED: connect a real store via OAuth (Shopify's Dev Dashboard no longer mints static
# Admin tokens for new apps). Create an app in the Shopify Dev Dashboard, register
# {PUBLIC_BASE_URL}/shopify/oauth as the redirect URL, set the two CLIENT vars, then open
# /shopify/oauth?shop=your-store.myshopify.com — the minted token is stored server-side
# (IntegrationCredential; never sent to a browser) and commerce flips to the real Admin API.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# LEGACY path (still honored if you have an old-style token): store domain + Admin API token.
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STOREFRONT_TOKEN=
# Webhook signing secret. Defaults to SHOPIFY_CLIENT_SECRET when set (OAuth apps sign with it).
SHOPIFY_WEBHOOK_SECRET=dev-secret-change-me

# --- Misc
NWS_POINT=https://api.weather.gov/gridpoints/OKX/33,35/forecast
DEMO_MODE=1
PORT=4477
# Base URL judges/phones reach (LAN IP or tunnel URL); QR codes point here. Empty → auto-detect LAN IP.
PUBLIC_BASE_URL=
