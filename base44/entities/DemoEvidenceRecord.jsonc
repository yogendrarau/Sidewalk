{
  "name": "DemoEvidenceRecord",
  "description": "Synthetic sales evidence; no payment credentials or money movement.",
  "type": "object",
  "properties": {
    "demo_session_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 32
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "kind": {
      "type": "string",
      "enum": [
        "cash_self_reported",
        "card_simulated"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "note_key": {
      "type": "string",
      "maxLength": 200
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "demo_session_id",
    "amount",
    "kind",
    "recorded_at",
    "confirmed",
    "provenance"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
