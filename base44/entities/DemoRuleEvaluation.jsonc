{
  "name": "DemoRuleEvaluation",
  "type": "object",
  "properties": {
    "demo_session_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "original_transcript": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "wo",
        "ar",
        "bn",
        "zh-Hans",
        "fr"
      ],
      "default": "es"
    },
    "intent": {
      "type": "string"
    },
    "rulebook_hash": {
      "type": "string"
    },
    "answer_key": {
      "type": "string"
    },
    "answer_text": {
      "type": "string"
    },
    "answer_text_en": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "answer",
        "abstain"
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "unknown_intent",
        "missing_facts",
        "missing_translation"
      ]
    },
    "trace": {
      "type": "string"
    },
    "missing_facts": {
      "type": "array"
    },
    "source": {
      "type": "string"
    },
    "abstention": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "demo_session_id",
    "question"
  ]
}
