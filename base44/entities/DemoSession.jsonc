{
  "name": "DemoSession",
  "type": "object",
  "properties": {
    "demo_session_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "wo",
        "ar",
        "bn",
        "zh-Hans",
        "fr"
      ],
      "default": "es"
    },
    "provider_modes": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "reset_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "demo_session_id",
    "code",
    "locale",
    "provider_modes",
    "started_at"
  ]
}
