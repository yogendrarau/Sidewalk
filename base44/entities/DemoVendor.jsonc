{
  "name": "DemoVendor",
  "type": "object",
  "properties": {
    "demo_session_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "wo",
        "ar",
        "bn",
        "zh-Hans",
        "fr"
      ],
      "default": "es"
    },
    "vendor_type": {
      "type": "string"
    },
    "has_sales_tax_certificate": {
      "type": "boolean"
    },
    "case_summary": {
      "type": "string"
    },
    "case_status_key": {
      "type": "string"
    },
    "case_summary_key": {
      "type": "string"
    },
    "next_step_key": {
      "type": "string"
    },
    "missing_item_key": {
      "type": "string"
    },
    "next_step": {
      "type": "string"
    },
    "missing_item": {
      "type": "string"
    },
    "is_fictional": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "demo_session_id",
    "name"
  ]
}
