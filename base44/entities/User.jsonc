{
  "properties": {
    "role": {
      "type": "string",
      "description": "Base44 authorization role. Do not use this field for marketplace routing.",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_role": {
      "type": "string",
      "description": "Marketplace experience selected by the user. This is a routing preference, never an authorization role.",
      "enum": [
        "buyer",
        "vendor"
      ]
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}
